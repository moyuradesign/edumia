APP_NAME=Edumia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_TIMEZONE=UTC
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edumia
DB_USERNAME=edumia
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME=Edumia

# Payments are disabled until an operator verifies the Stripe account,
# test checkout, signed webhooks and HTTPS. Never commit real secrets.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Default accounting commission: 20%. Earnings remain held until payouts are implemented.
EDUMIA_COMMISSION_BPS=2000
# Bakong read-only API adapter. No public KHQR checkout until merchant QR issuance,
# order-specific reference binding, recipient and settlement acceptance.
BAKONG_ENABLED=false
BAKONG_BASE_URL=https://sit-api-bakong.nbc.gov.kh
BAKONG_ACCESS_TOKEN=
BAKONG_RECEIVER_ACCOUNT=
