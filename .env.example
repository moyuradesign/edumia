APP_NAME=Edumia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_TIMEZONE=UTC
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edumia
DB_USERNAME=edumia
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME=Edumia

# Payments are disabled until an operator verifies the Stripe account,
# test checkout, signed webhooks and HTTPS. Never commit real secrets.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate operator release gate. Never set this based only on CI or an API ping.
STRIPE_LIVE_APPROVED=false

# Default accounting commission: 20%. Earnings remain held until payouts are implemented.
EDUMIA_COMMISSION_BPS=2000
# Bakong read-only API adapter. No public KHQR checkout until merchant QR issuance,
# order-specific reference binding, recipient and settlement acceptance.
BAKONG_ENABLED=false
BAKONG_BASE_URL=https://sit-api-bakong.nbc.gov.kh
BAKONG_ACCESS_TOKEN=
BAKONG_RECEIVER_ACCOUNT=

# Secure operational email: disabled until a genuine SMTP test has been
# accepted, the recipient inbox has been checked, and a database queue
# worker is running. Never enter credentials in a dashboard or Git.
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=20
EDUMIA_SMTP_TEST_ENABLED=false
# Exact address of the signed-in test administrator. Must belong to an approved sandbox recipient.
EDUMIA_SMTP_TEST_RECIPIENT=
EDUMIA_MAIL_PROVIDER_VERIFIED=false
# Set true only after confirming a supervised queue worker actually processes notifications.
EDUMIA_QUEUE_WORKER_VERIFIED=false
EDUMIA_TRANSACTIONAL_MAIL_ENABLED=false
# After independent acceptance, optionally use QUEUE_CONNECTION=database.
# A queue worker is required to process the isolated notifications queue.
